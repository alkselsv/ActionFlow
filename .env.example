# Local development settings. Copy to .env and replace placeholders.
# Never commit .env or put real API keys/passwords in this example file.

# PostgreSQL used by the application.
ACTIONFLOW_DB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
ACTIONFLOW_DATABASE_URL=postgresql+psycopg://actionflow:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/actionflow

# Local frontend/API origin.
ACTIONFLOW_FRONTEND_ORIGIN=http://127.0.0.1:5173

# Temporal server and worker queue.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=actionflow
TEMPORAL_DB_PASSWORD=REPLACE_WITH_LOCAL_TEMPORAL_PASSWORD

# LLM provider. External LLM/embedding calls are allowed for the configured
# provider; keep credentials outside Git. Empty provider/model/key keeps the
# local baseline adapter in use.
ACTIONFLOW_LLM_PROVIDER=
ACTIONFLOW_LLM_MODEL=
ACTIONFLOW_LLM_API_KEY=
ACTIONFLOW_LLM_BASE_URL=
ACTIONFLOW_LLM_TIMEOUT_SECONDS=60
ACTIONFLOW_LLM_MAX_ATTEMPTS=4
ACTIONFLOW_LLM_BUDGET_USD=
ACTIONFLOW_LLM_INPUT_COST_USD_PER_MILLION=
ACTIONFLOW_LLM_OUTPUT_COST_USD_PER_MILLION=

# Embeddings are optional and use a separate provider/model/credential.
ACTIONFLOW_EMBEDDING_PROVIDER=
ACTIONFLOW_EMBEDDING_MODEL=
ACTIONFLOW_EMBEDDING_API_KEY=
ACTIONFLOW_EMBEDDING_BASE_URL=
ACTIONFLOW_EMBEDDING_TIMEOUT_SECONDS=60
