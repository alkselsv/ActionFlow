# Local development settings. Copy to .env and replace placeholders.
# Never commit real API keys or passwords.

# PostgreSQL. Docker Compose and the application both use these values.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=actionflow

# Optional explicit SQLAlchemy URL. It overrides POSTGRES_* when set.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/actionflow
# ACTIONFLOW_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/actionflow

# Local frontend/API origin.
ACTIONFLOW_FRONTEND_ORIGIN=http://127.0.0.1:5173

# Temporal server, worker queue and Temporal PostgreSQL.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=actionflow
TEMPORAL_DB_PASSWORD=postgres

# OpenAI-compatible LLM. Leave OPENAI_API_KEY empty to keep the local baseline.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

# Optional limits and pricing. Unknown values stay empty; unknown cost is null.
ACTIONFLOW_LLM_TIMEOUT_SECONDS=60
ACTIONFLOW_LLM_MAX_ATTEMPTS=4
ACTIONFLOW_LLM_BUDGET_USD=
ACTIONFLOW_LLM_INPUT_COST_USD_PER_MILLION=
ACTIONFLOW_LLM_OUTPUT_COST_USD_PER_MILLION=
ACTIONFLOW_EMBEDDING_TIMEOUT_SECONDS=60
